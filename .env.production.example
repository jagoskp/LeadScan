# LeadScan AI Production Environment Settings Blueprint
APP_ENV=production
DEBUG=false
LOG_LEVEL=WARNING
DATABASE_URL=postgresql+asyncpg://production-db.local:5432/leadscan_production
REDIS_URL=rediss://production-redis.local:6379/0
JWT_SECRET_KEY=MUST_BE_REPLACED_WITH_SECURE_KEY_MIN_32_CHARS
# Ensure other parameters (pools, limits) align with high scale load
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=20
