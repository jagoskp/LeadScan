# Centralized LeadScan AI Environment Variables Template
APP_NAME="LeadScan AI"
APP_ENV=development
DEBUG=true

# Database Settings
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leadscan_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Connection Settings
REDIS_URL=redis://localhost:6379/0

# Celery Worker Connection Settings
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT Auth parameters
JWT_SECRET_KEY=change_me_in_production_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging Levels (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Core Feature Toggle Flags
ENABLE_OCR=true
ENABLE_AI_EXTRACTION=true
ENABLE_NOTIFICATIONS=true
ENABLE_AUDIT=true
